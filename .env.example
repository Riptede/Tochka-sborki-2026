# Шаблон переменных окружения. Скопируйте в .env и заполните: cp .env.example .env
# .env в git не попадает (.gitignore). Его читают scripts/run_pipeline.py и scripts/demo.py при запуске;
# импорт пакета attrex окружение не меняет. Переменные, уже заданные в окружении, важнее значений из .env:
# на ВМ хакатона OPENAI_BASE_URL и OPENAI_API_KEY задаёт платформа, .env там не нужен.
# Без ключа решение работает целиком: шаг LLM и API-эмбеддинги пропускаются, а не падают.

# OpenAI-совместимый API платформы: шаг LLM (llm/extractor.py) и эмбеддинги BAAI/bge-m3 (embeddings.backend: api)
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Свои пути к данным задаются в окружении оболочки, а не здесь: они читаются при импорте attrex.paths.
#   export ATTREX_RAW=/path/to/raw          # по умолчанию data/raw
#   export ATTREX_DB=/path/to/attrex.duckdb # по умолчанию data/attrex.duckdb
